{
  "name": "holt-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for holt: unobtrusive screenshots, recordings and notes for QA, written straight into your repo.",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "pnpm -r --filter './packages/**' run test",
    "test:coverage": "pnpm -r --filter \"./packages/**\" run test:coverage",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "dev:server": "pnpm --filter @velvet-thunder/holt run dev",
    "start:server": "pnpm --filter @velvet-thunder/holt run build && node scripts/start-server.mjs",
    "dev:extension": "pnpm --filter @holt/extension run dev",
    "package:extension": "pnpm --filter @holt/extension run package"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.24.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
