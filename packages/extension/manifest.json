{
  "manifest_version": 3,
  "name": "nitpick",
  "version": "0.0.0",
  "description": "Screenshots, screen recordings and notes for QA, written straight into your repo by the local nitpick server.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "nitpick: open the QA side panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "sidePanel", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Open the nitpick side panel"
    },
    "screenshot-viewport": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Screenshot the visible part of the page"
    },
    "screenshot-full": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Screenshot the full page (scroll and stitch)"
    },
    "screenshot-area": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Screenshot a selected area"
    },
    "toggle-recording": {
      "description": "Start/stop screen recording (opens the panel; starting needs a click)"
    },
    "toggle-voice": {
      "description": "Start/stop a voice note"
    },
    "quick-note": {
      "description": "Open the panel with the note field focused"
    }
  }
}
