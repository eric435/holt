{
  "manifest_version": 3,
  "name": "holt",
  "version": "0.0.0",
  "description": "Screenshots, screen recordings and notes for QA, written straight into your repo by the local holt server.",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "holt: open the QA side panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "storage",
    "offscreen",
    "tabCapture"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "commands": {
    "screenshot-viewport": {
      "description": "Screenshot the visible part of the page; suggested: Alt+X"
    },
    "screenshot-area": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Screenshot a selected area"
    },
    "toggle-voice": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Start/stop a voice note"
    },
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Start/stop recording this tab"
    },
    "screenshot-full": {
      "description": "Screenshot the full page (scroll and stitch); suggested: Alt+W"
    },
    "quick-note": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Type a note about this page"
    },
    "open-panel": {
      "description": "Open the holt side panel"
    }
  }
}
