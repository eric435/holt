{
  "name": "@velvet-thunder/holt",
  "version": "0.0.2",
  "description": "Local server for the holt Chrome extension: writes screenshots, recordings and QA notes straight into your repo as markdown. CLI + Vite plugin, zero dependencies.",
  "license": "MIT",
  "keywords": [
    "qa",
    "screenshot",
    "screen-recording",
    "notes",
    "markdown",
    "vite-plugin",
    "chrome-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eric435/holt.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/eric435/holt#readme",
  "bugs": {
    "url": "https://github.com/eric435/holt/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "holt": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/copy-license.mjs && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check-pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "pnpm build && node scripts/check-pack.mjs"
  },
  "peerDependencies": {
    "vite": "^5.4.12 || ^6.0.9 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holt/protocol": "workspace:*",
    "vite": "^5.4.21"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
